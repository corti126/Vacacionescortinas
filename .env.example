# Configuración de Firebase para Brasil Trip
# Copiar este archivo a .env.local y completar con los valores reales del proyecto Firebase.
# .env.local NO se sube al repositorio (está en .gitignore).

VITE_FIREBASE_API_KEY=tu_api_key
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=1:tu_messaging_sender_id:web:tu_app_id
