VITE_FIREBASE_AUTH_DOMAIN=vacacionescortinas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vacacionescortinas
VITE_FIREBASE_STORAGE_BUCKET=vacacionescortinas.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=86475346344
VITE_FIREBASE_APP_ID=1:86475346344:web:c4294f78e073232080cd9d
